# ============================================================
# LLM 模式 (二选一)
# ============================================================
#
# 模式 A — Sampling (零配置，推荐)
#   复用 MCP 客户端（Cursor / WorkBuddy 等）已配置的模型，
#   无需填写任何 API key。
#   只需不设置 LLM_API_BASE / LLM_API_KEY，或显式设置:
#     LLM_MODE=sampling
#
# 模式 B — Direct (直连 OpenAI 兼容 API)
#   MCP Server 自行调用外部 LLM API。
#   需要同时设置 LLM_API_BASE + LLM_API_KEY + LLM_MODEL_NAME。
#   当这三个变量都配置好时会自动激活，也可显式设置:
#     LLM_MODE=direct
#
LLM_MODE=sampling

# ============================================================
# 以下仅在 Direct 模式下需要
# ============================================================
# LLM_API_BASE=http://127.0.0.1:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL_NAME=hy3

# SQLite database path (optional, defaults to ./cognitive.db)
COGNITIVE_DB_PATH=./cognitive.db